{
  "description": "SUMO scenario catalog for vehicle-side training data. Each scenario overrides 'defaults'. A run = (scenario, seed). Splits are by run: train/val/test seeds of the training scenarios, plus held-out scenarios used only for testing generalization.",
  "defaults": {
    "geometry": "2lane",
    "warmup_s": 300,
    "logged_s": 1200,
    "veh_per_hour": 450,
    "approach_jitter": 0.3,
    "turn_shares": {"left": 0.15, "straight": 0.70, "right": 0.15},
    "speed_factor": {"mean": 1.0, "sd": 0.1, "min": 0.75, "max": 1.3},
    "aggr_share": 0.08,
    "truck_share": 0.05,
    "cv_share": 0.15,
    "ped_per_hour": 150,
    "target_ped_factor": 1.6,
    "ped_speed": {"mean": 1.30, "sd": 0.25, "min": 0.60, "max": 1.80},
    "min_green_s": 7,
    "max_green_s": 40,
    "ped_walk_speed_design_mps": 1.07,
    "spat_profile": "full"
  },
  "scenarios": {
    "base":        {},
    "peak":        {"veh_per_hour": 650},
    "offpeak":     {"veh_per_hour": 250, "speed_factor": {"mean": 1.1, "sd": 0.1, "min": 0.8, "max": 1.4}},
    "ped_heavy":   {"ped_per_hour": 400},
    "turn_heavy":  {"turn_shares": {"left": 0.30, "straight": 0.40, "right": 0.30}},
    "aggressive":  {"aggr_share": 0.30},
    "short_green": {"min_green_s": 5, "max_green_s": 25},
    "slow_walkers": {"ped_per_hour": 250, "ped_speed": {"mean": 0.95, "sd": 0.20, "min": 0.50, "max": 1.40}},
    "wide_3lane":  {"geometry": "3lane"}
  },
  "splits": {
    "train_scenarios": ["base", "peak", "offpeak", "ped_heavy", "turn_heavy", "aggressive", "short_green"],
    "train_seeds": [1, 2, 3],
    "val_seeds": [4],
    "test_seeds": [5],
    "heldout_scenarios": ["slow_walkers", "wide_3lane"],
    "heldout_seeds": [5, 6]
  },
  "geometries": {
    "2lane": {"lanes_per_direction": 2, "leg_m": 300, "speed_mps": 13.41},
    "3lane": {"lanes_per_direction": 3, "leg_m": 300, "speed_mps": 13.41}
  }
